{
  "name": "@microphi/endpoint",
  "version": "2.3.1",
  "description": "Decorators for API endpoints (@Endpoint, @Lambda, @Body, @Path) served on AWS Lambda, Express or as MCP tools, with Standard Schema validation; their metadata also drives the serverless.yml functions block",
  "main": "lib/cjs/index.js",
  "typings": "lib/esm/index.d.ts",
  "module": "lib/esm/index.js",
  "files": [
    "lib",
    "AGENTS.md",
    "ERRORS.md"
  ],
  "license": "MIT",
  "author": {
    "name": "Davide Cavaliere",
    "email": "cavaliere.davide@gmail.com",
    "url": "https://github.com/microph1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microph1/microphi.git",
    "directory": "packages/endpoint"
  },
  "homepage": "https://github.com/microph1/microphi/tree/master/packages/endpoint#readme",
  "bugs": {
    "url": "https://github.com/microph1/microphi/issues"
  },
  "keywords": [
    "typescript",
    "decorator",
    "lambda",
    "aws",
    "express",
    "serverless",
    "api",
    "endpoint",
    "mcp",
    "standard-schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -b tsconfig.cjs.json",
    "build:ci": "npm run build",
    "test:ci": "vitest run --coverage",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/aws-lambda": "^8.10.96",
    "@types/serverless": "^3.12.0"
  },
  "peerDependencies": {
    "@microphi/debug": "^2.11.0",
    "@microphi/di": "^2.12.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@microphi/debug": "^2.11.0",
    "@microphi/di": "^2.12.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "utility-types": "^3.10.0",
    "zod": "^4.6.7"
  },
  "sideEffects": false
}
