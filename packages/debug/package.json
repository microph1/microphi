{
  "name": "@microphi/debug",
  "version": "2.11.0",
  "description": "Namespaced console.log wrapper, filtered by the DEBUG env var",
  "main": "lib/cjs/index.js",
  "typings": "lib/esm/index.d.ts",
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/esm/index.d.ts"
    },
    "./console-to-file": {
      "import": "./lib/esm/lib/console-to-file.js",
      "require": "./lib/cjs/lib/console-to-file.js",
      "types": "./lib/esm/lib/console-to-file.d.ts"
    }
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "private": false,
  "keywords": [
    "log",
    "debug",
    "console"
  ],
  "author": {
    "name": "Davide Cavaliere",
    "email": "cavaliere.davide@gmail.com",
    "url": "https://github.com/microph1"
  },
  "homepage": "https://github.com/microph1/microphi/tree/master/packages/debug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microph1/microphi.git",
    "directory": "packages/debug"
  },
  "dependencies": {
    "tslib": "^2.5.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -b tsconfig.cjs.json",
    "build:ci": "npm run build",
    "test:ci": "vitest run --coverage",
    "lint": "eslint ./src"
  },
  "bugs": {
    "url": "https://github.com/microph1/microphi/issues"
  }
}
