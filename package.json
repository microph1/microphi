{
  "name": "microphi",
  "version": "0.0.0",
  "licence": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/www.dcsoftware.io"
    ]
  },
  "scripts": {
    "ng": "ng",
    "l": "lerna",
    "start": "ng serve",
    "build": "lerna run build",
    "build:ci": "lerna run build:ci --stream",
    "test": "jest && vitest run",
    "test:ci": "lerna run test:ci --stream",
    "lint:ci": "lerna run lint --parallel",
    "e2e": "ng e2e",
    "deploy:ci": "lerna publish -y --conventional-commits --create-release github --loglevel verbose --no-private",
    "release": "lerna version --conventional-commits",
    "deploy": "lerna run deploy --stream --scope"
  },
  "private": true,
  "devDependencies": {
    "@angular/language-server": "^17.3.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^7.3.0",
    "@lerna-lite/changed": "^5.6.4",
    "@lerna-lite/cli": "^5.6.4",
    "@lerna-lite/diff": "^5.6.4",
    "@lerna-lite/exec": "^5.6.4",
    "@lerna-lite/list": "^5.6.4",
    "@lerna-lite/publish": "^5.6.4",
    "@lerna-lite/run": "^5.6.4",
    "@lerna-lite/version": "^5.6.4",
    "@lerna-lite/watch": "^5.6.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^16.0.0",
    "jest-preset-angular": "^14.2.2",
    "ng-packagr": "^17.3.0",
    "protractor": "~7.0.0",
    "serverless": "^3.19.0",
    "serverless-finch": "^4.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.8.1",
    "typescript": "~5.4.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
